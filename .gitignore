.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
*.egg-info/
.pytest_cache/

# large binary checkpoints/data -- never committed, re-downloaded via a documented fetch step
/checkpoints/
*.tar
*.pth
*.ckpt

# TMR's pretrained checkpoint (124MB, MIT-licensed, fetched via gdown -- see notebooks/02's own
# setup cell for the exact download command and md5 checksum, same convention as /checkpoints/)
third_party/TMR/models/

# local pointer to the read-only original-project archive (not published)
.archive_path

# git history scrub expressions -- necessarily contains the literal identifier strings the
# scrub removed, so kept local/gitignored rather than committed; documenting the scrub would
# reintroduce the very strings it removed (see docs/LANDMINES.md §21)
.scrub_expressions.txt

# regenerable demo retrieval cache (17MB, rebuilt automatically from the materialized corpus +
# evaluator on first run if missing -- same convention as dataset/t2m_test.npy)
artifacts/demo/embedding_retrieval_cache.pkl

# internal working files (run ledger, review queue, supervisor prompts, guidance drafts) --
# kept locally, not published; the repo stays a record of the work, not of the process
/internal/

# read by Claude Code tooling from the project root, so it stays in place on disk -- but it is
# process/workflow instruction, not project documentation, so it is not published
/CLAUDE.md

# E3's raw generated-motion cache (~915MB at n=4640, one batch of 32 per .npz) -- regenerable
# from scripts/e3_generate.py against the same checkpoint and seed; e3_record.json (the actual
# scored results) is the small, committed artifact that matters
artifacts/e3/batches/
artifacts/e3/_smoketest/
