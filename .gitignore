.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
*.egg-info/
.pytest_cache/

# large binary checkpoints/data -- never committed, re-downloaded via a documented fetch step
/checkpoints/
*.tar
*.pth
*.ckpt

# TMR's pretrained checkpoint (124MB, MIT-licensed, fetched via gdown -- see notebooks/02's own
# setup cell for the exact download command and md5 checksum, same convention as /checkpoints/)
third_party/TMR/models/

# local pointer to the read-only original-project archive (not published)
.archive_path

# git history scrub expressions (Item 34) -- necessarily contains the literal identifier
# strings the scrub removed, so kept local/gitignored rather than committed, or documenting
# the scrub would reintroduce the very strings it removed (review SUP-20260906-50)
.scrub_expressions.txt

# regenerable demo retrieval cache (17MB, rebuilt automatically from the materialized corpus +
# evaluator on first run if missing -- same convention as dataset/t2m_test.npy)
artifacts/demo/embedding_retrieval_cache.pkl
